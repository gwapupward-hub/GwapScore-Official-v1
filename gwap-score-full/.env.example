# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/gwapscore
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gwapscore
DB_USER=gwapscore_user
DB_PASSWORD=change_me_in_production

# API Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3001

# Social reputation / Instagram OAuth (required to link accounts)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/v1/social/oauth/callback
SOCIAL_OAUTH_STATE_SECRET=replace_with_at_least_32_random_bytes
SOCIAL_TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes

# Solana Configuration (optional)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Telegram Configuration (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

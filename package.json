{
  "name": "gwapscore-official-v1",
  "version": "0.1.0",
  "private": true,
  "description": "GwapScore TypeScript project",
  "engines": { "node": ">=18" },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
